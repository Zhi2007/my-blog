---
import { TODAY } from '../consts';
---

<div class="today" id="today-progress">
  <span class="today-title">{TODAY.label}</span>
  <span class="today-bar" aria-hidden="true">
    <i id="today-bar-fill" />
  </span>
  <span class="today-text" id="today-text">
    计算中…
  </span>
</div>

<script type="application/json" id="today-config" set:html={JSON.stringify(TODAY)} />

<script>
  const box = document.getElementById('today-progress');
  const configEl = document.getElementById('today-config');
  const textEl = document.getElementById('today-text');
  const fillEl = document.getElementById('today-bar-fill');

  if (box && textEl) {
    const cfg = configEl ? JSON.parse(configEl.textContent || '{}') : {};
    const pad = (n) => String(n).padStart(2, '0');

    const render = () => {
      const now = new Date();
      // 按访客本地时区取「今天 00:00」和「明天 00:00」
      const start = new Date(now);
      start.setHours(0, 0, 0, 0);
      const end = new Date(start);
      end.setDate(end.getDate() + 1);

      const total = end.getTime() - start.getTime();
      const passed = now.getTime() - start.getTime();
      // 中午 12:00 就是 50%；夏令时导致 23/25 小时的天也按真实长度算
      const pct = Math.min(100, Math.max(0, (passed / total) * 100));

      const leftMs = end.getTime() - now.getTime();
      const hh = pad(Math.floor(leftMs / 3600000));
      const mm = pad(Math.floor((leftMs % 3600000) / 60000));
      const ss = pad(Math.floor((leftMs % 60000) / 1000));

      textEl.textContent =
        cfg.showRemaining === false
          ? `${pct.toFixed(3)}%`
          : `${pct.toFixed(3)}% · 距明天还有 ${hh}:${mm}:${ss}`;
      if (fillEl) fillEl.style.width = `${pct}%`;
      box.setAttribute('title', `按本机时间计算（${pad(now.getHours())}:${pad(now.getMinutes())}）`);
    };

    render();
    window.setInterval(render, 1000);
  }
</script>
