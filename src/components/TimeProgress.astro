---
import { PROGRESS } from '../consts';

const rows = [
  { kind: 'day', label: PROGRESS.labels.day },
  { kind: 'month', label: PROGRESS.labels.month },
  { kind: 'year', label: PROGRESS.labels.year },
];
---

<div class="progress-list" id="time-progress">
  {
    rows.map((row) => (
      <div class="progress-row" data-kind={row.kind}>
        <span class="progress-label">{row.label}</span>
        <span class="progress-bar" aria-hidden="true">
          <i />
        </span>
        <span class="progress-text">计算中…</span>
      </div>
    ))
  }
</div>

<script type="application/json" id="progress-config" set:html={JSON.stringify(PROGRESS)} />

<script>
  const box = document.getElementById('time-progress');
  const configEl = document.getElementById('progress-config');

  if (box && configEl) {
    const cfg = JSON.parse(configEl.textContent || '{}');
    const pad = (n) => String(n).padStart(2, '0');

    // 全部按访客本地时区取区间：今天/本月/本年的起点与终点
    const getSpans = () => {
      const now = new Date();

      const dayStart = new Date(now);
      dayStart.setHours(0, 0, 0, 0);
      const dayEnd = new Date(dayStart);
      dayEnd.setDate(dayEnd.getDate() + 1);

      // 月份用 new Date(y, m, 1)，JS 会自动处理 12 月进位
      const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
      const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 1);

      const yearStart = new Date(now.getFullYear(), 0, 1);
      const yearEnd = new Date(now.getFullYear() + 1, 0, 1);

      return {
        now,
        day: [dayStart, dayEnd],
        month: [monthStart, monthEnd],
        year: [yearStart, yearEnd],
      };
    };

    const render = () => {
      const { now, ...spans } = getSpans();

      for (const kind of Object.keys(spans)) {
        const row = box.querySelector(`[data-kind="${kind}"]`);
        if (!row) continue;

        const [start, end] = spans[kind];
        const total = end.getTime() - start.getTime();
        const passed = now.getTime() - start.getTime();
        const pct = Math.min(100, Math.max(0, (passed / total) * 100));

        const fill = row.querySelector('.progress-bar > i');
        if (fill) fill.style.width = `${pct}%`;

        let suffix = '';
        if (cfg.showRemaining !== false) {
          if (kind === 'day') {
            const left = end.getTime() - now.getTime();
            suffix = ` · 距明天还有 ${pad(Math.floor(left / 3600000))}:${pad(
              Math.floor((left % 3600000) / 60000),
            )}:${pad(Math.floor((left % 60000) / 1000))}`;
          } else {
            suffix = ` · 还剩 ${Math.ceil((end.getTime() - now.getTime()) / 86400000)} 天`;
          }
        }

        const text = row.querySelector('.progress-text');
        // 今天的小数位多一点，看起来是"活的"；月/年变化慢，两位就够
        if (text) text.textContent = `${pct.toFixed(kind === 'day' ? 3 : 2)}%${suffix}`;
      }
    };

    render();
    window.setInterval(render, 1000);
  }
</script>
