---
import { SITE, NAV } from '../consts';
import TimeProgress from '../components/TimeProgress.astro';
import TabTitle from '../components/TabTitle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 用于 RSS 等场景的发布时间 */
  pubDate?: Date;
  /** 横幅大标题，默认用页面 title（没有则用站点标题） */
  bannerTitle?: string;
  /** 横幅副标题，默认用页面 description */
  bannerSubtitle?: string;
  /** 首页用更高的横幅 */
  bannerLarge?: boolean;
}

const {
  title,
  description = SITE.description,
  bannerTitle = title ?? SITE.title,
  bannerSubtitle = description,
  bannerLarge = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const currentPath = Astro.url.pathname;

// 主题色相与可选背景图通过内联变量注入，其余样式全部由 CSS 派生
const rootStyle = [
  `--hue:${SITE.hue}`,
  SITE.bannerImage ? `--banner-image:url('${SITE.bannerImage}')` : '',
]
  .filter(Boolean)
  .join(';');
---

<!doctype html>
<html lang={SITE.lang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="wallpaper" aria-hidden="true"></div>

    <header class="navbar">
      <div class="navbar-inner">
        <a class="brand" href="/">{SITE.title}</a>
        <nav class="site-nav">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <div class="page">
      <section class:list={['banner', bannerLarge && 'banner-large']}>
        <div class="banner-inner">
          <h1 class="banner-title" data-pagefind-meta="title">{bannerTitle}</h1>
          {bannerSubtitle && <p class="banner-subtitle">{bannerSubtitle}</p>}
        </div>
      </section>

      <main class="content-card">
        <slot />
      </main>

      <footer class="site-footer">
        <TimeProgress />
        <p>© {new Date().getFullYear()} {SITE.author} · 由 Astro 构建，托管在 Cloudflare Workers</p>
      </footer>
    </div>

    {/* Cloudflare Web Analytics：token 为空时不加载任何脚本 */}
    {
      SITE.cfAnalyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.cfAnalyticsToken}"}`}
        />
      )
    }

    {/* 切到别的标签页时把标题换成轮播文案 */}
    <TabTitle />
  </body>
</html>
